<% layout("../views/layouts/boilerplate")%>

<div class="row offset-3 mt-3">
<div class="card col-8">
  <h3><%=listing.title%> </h3>
  <img src="<%=listing.image%>" class="card-img-top" alt="Listing_image" style="height: 30vh;">
  <div class="card-body">
  <h5 class="card-title"></h5>
    <p class="card-text">
            
            <%=listing.description%> <br>
            &#8377; <%=listing.price.toLocaleString("en-In")%> <br>
            <%=listing.country%> <br>
            <%=listing.location%> <br>
    </p>
    <div class="d-flex gap-2">
     <a href="/listings/<%=listing._id%>/update" class="btn edit-btn">Edit</a>
       <form action="/listings/delete/<%=listing.id%>?_method=DELETE" method="POST">
                <button class="btn delete-btn">Delete</button>
        </form>
    </div>
  </div>
</div>
</div>



<div class="col-8 offset-3 mb-2">
    <hr>
    <h4>Leave a Review</h4>
    <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
      <div class="mb-2 mt-2">
        <label for="rating" class="form-label">Rating</label>
        <input 
          type="range" 
          min="1" 
          max="5" 
          id="rating" 
          name="review[rating]" 
          class="form-range"
        >
      </div>

      <div class="mb-2 mt-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea 
          name="review[comment]" 
          id="comment" 
          cols="30" 
          rows="5" 
          class="form-control" 
          required
        ></textarea>
        <div class="invalid-feedback">
          Please submit some comments for review
        </div>
      </div>

      <button class="btn btn-outline-dark">Submit</button>
    </form>
  </div>

